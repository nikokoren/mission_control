{%- comment -%} Title tier by name length: ~34/42/60 chars a line. {%- endcomment -%}
{%- assign title_cls = "title title--large lg:title--xxlarge" -%}
{%- if name.size > 22 -%}{%- assign title_cls = "title lg:title--xlarge" -%}{%- endif -%}
{%- if name.size > 34 -%}{%- assign title_cls = "title title--small lg:title--large" -%}{%- endif -%}

{%- comment -%} BY / FOR / ON / FROM values: one step up on the X, where the
    plain description read cramped. description--large is the next size;
    xlarge is two steps and too heavy for four fields in one row. The OG
    stays at plain description. {%- endcomment -%}
{%- assign info_cls = "description lg:description--large" -%}

{%- comment -%} The X has its own slot pair, built without the cards its
    destination panel and footer already show. A payload from before those
    fields existed falls back to the OG pair. {%- endcomment -%}
{%- if lg_slot_a_label == nil -%}
  {%- assign xa_label = slot_a_label -%}{%- assign xa_text = slot_a_text -%}
  {%- assign xb_label = slot_b_label -%}{%- assign xb_text = slot_b_text -%}
{%- else -%}
  {%- assign xa_label = lg_slot_a_label -%}{%- assign xa_text = lg_slot_a_text -%}
  {%- assign xb_label = lg_slot_b_label -%}{%- assign xb_text = lg_slot_b_text -%}
{%- endif -%}
{%- comment -%} Present only when there is a card about this flight left over. {%- endcomment -%}
{%- assign xc_label = lg_slot_c_label | default: "" -%}
{%- assign xc_text = lg_slot_c_text | default: "" -%}

{%- comment -%} The footer exists only after launch, only with a next event,
    and only on the X. Absent, it takes no row and gives its height back. {%- endcomment -%}
{%- assign has_footer = false -%}
{%- if footer_kind == "launch" or footer_kind == "docking" -%}{%- assign has_footer = true -%}{%- endif -%}

{%- assign a_len = slot_a_text | size -%}
{%- assign a_cls = "description description--large lg:description--xlarge" -%}
{%- assign a_clamp = 7 -%}
{%- if a_len > 400 -%}
  {%- assign a_cls = "description lg:description--large" -%}
  {%- assign a_clamp = 8 -%}
{%- endif -%}
{%- if a_len > 520 -%}
  {%- assign a_cls = "label label--small lg:description" -%}
  {%- assign a_clamp = 9 -%}
{%- endif -%}

{%- assign b_len = slot_b_text | size -%}
{%- assign b_cls = "description description--large lg:description--xlarge" -%}
{%- assign b_clamp = 5 -%}
{%- if b_len > 285 -%}
  {%- assign b_cls = "description lg:description--large" -%}
  {%- assign b_clamp = 6 -%}
{%- endif -%}
{%- if b_len > 410 -%}
  {%- assign b_cls = "label label--small lg:description" -%}
  {%- assign b_clamp = 7 -%}
{%- endif -%}

{%- comment -%} Same tiers for the X pair. {%- endcomment -%}
{%- assign xa_len = xa_text | size -%}
{%- assign xa_cls = "description description--large lg:description--xlarge" -%}
{%- assign xa_clamp = 7 -%}
{%- if xa_len > 400 -%}{%- assign xa_cls = "description lg:description--large mc-regular" -%}{%- assign xa_clamp = 8 -%}{%- endif -%}
{%- if xa_len > 520 -%}{%- assign xa_cls = "label label--small lg:description" -%}{%- assign xa_clamp = 9 -%}{%- endif -%}
{%- assign xb_len = xb_text | size -%}
{%- assign xb_cls = "description description--large lg:description--xlarge" -%}
{%- assign xb_clamp = 5 -%}
{%- if xb_len > 285 -%}{%- assign xb_cls = "description lg:description--large mc-regular" -%}{%- assign xb_clamp = 6 -%}{%- endif -%}
{%- if xb_len > 410 -%}{%- assign xb_cls = "label label--small lg:description" -%}{%- assign xb_clamp = 7 -%}{%- endif -%}
{%- comment -%} The third card is the supporting one: a size below the
    other two, so three cards read as two stories and a footnote. {%- endcomment -%}
{%- assign xc_cls = "description lg:description--large mc-regular" -%}

<div class="layout">
  <div class="flex flex--col w--full h--full gap--small mx--2 my--2">
  <div class="flex flex--row portrait:flex--col flex--top w--full mc-fill gap--large portrait:gap--small">

    {%- comment -%} ============ MAIN COLUMN ============ {%- endcomment -%}
    <div class="w--[62cqw] portrait:w--full h--full portrait:h--[56cqh] {% if has_footer %}lg:portrait:h--[50cqh]{% endif %} flex flex--col gap--small">

      {%- comment -%} --- header --- {%- endcomment -%}
      <div class="flex flex--row flex--center-y w--full gap--medium">
        {%- if image != '' and image != blank -%}
          <img class="image shrink-0 {% if image_is_patch %} h--max-16 lg:h--max-28 {% else %}w--max-28 lg:w--max-36 h--max-16 lg:h--max-28{% endif %}" src="{{ image }}"
               onerror="this.onerror=null; this.style.display='none';" />
        {%- endif -%}

        <div class="flex flex--col flex--left grow gap--xsmall">
          <span class="label label--small lg:label--base">MISSION</span>
          <span class="{{ title_cls }}" data-clamp="2">{{ name }}</span>
        </div>

        <div class="flex flex--col flex--right shrink-0 gap--xsmall">
          {%- if mode == 'PRE_LAUNCH' -%}
            <span class="label label--small lg:label--base">COUNTDOWN</span>
            <span class="label label--outline lg:label--xlarge value--tnums">{{ countdown }}</span>
          {%- else -%}
            <span class="label label--small lg:label--base">STATUS</span>
            <span class="label lg:label--xlarge {% if status == 'Success' %}label--inverted{% else %}label--outline{% endif %}">
              {%- if status == 'Success' -%}SUCCESS
              {%- elsif status == 'Failure' -%}FAILURE
              {%- elsif status == 'Partial Failure' -%}PARTIAL FAIL
              {%- elsif status == 'PENDING' -%}CONFIRMING
              {%- else -%}{{ status | upcase }}
              {%- endif -%}
            </span>
          {%- endif -%}

          {% if mode == 'PRE_LAUNCH' and window_start_ts != window_end_ts %}
            {%- assign duration = window_end_ts | minus: window_start_ts -%}
            {%- assign elapsed = date_ts | minus: window_start_ts -%}
            {%- if duration > 0 -%}
              {%- assign pct = elapsed | times: 100.0 | divided_by: duration -%}
            {%- else -%}
              {%- assign pct = 50 -%}
            {%- endif -%}
            {%- if pct < 0 -%}{%- assign pct = 0 -%}{%- endif -%}
            {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
            {%- assign frac = pct | divided_by: 100.0 -%}

            <div class="mc-tl">
              <span class="label label--small lg:label--base">LAUNCH WINDOW</span>
              <div class="mc-tl-bar">
                <div class="mc-tl-line">
                  <div class="mc-tl-dot" style="left: calc(6px + {{ frac }} * (100% - 12px));"></div>
                </div>
                {%- comment -%} Hidden when T-0 equals an end label: the same
                    time twice, stacked, reads as a bug. {%- endcomment -%}
                {% if date_ts != window_start_ts and date_ts != window_end_ts %}
                <span class="mc-tl-t0 label label--small value--tnums" style="{% if pct < 15 %}left: 0;{% elsif pct > 85 %}right: 0;{% else %}left: {{ pct }}%; transform: translateX(-50%);{% endif %}">{{ date_ts | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span>
                {% endif %}
              </div>
              <div class="mc-tl-ends">
                <span class="label label--small value--tnums">{{ window_start_ts | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span>
                <span class="label label--small value--tnums">{{ window_end_ts | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} --- info row --- {%- endcomment -%}
      <div class="divider shrink-0"></div>

      {%- comment -%} On the X, BY and ON keep their width and FOR and FROM
          share what is left, each shrinking in proportion to its length,
          so a long agency and a long pad both wrap instead of one taking
          the room and the other being squeezed. Labels align at the top.
          The OG keeps its row as it was (mc-info is scoped to the X). {%- endcomment -%}
      <div class="flex flex--row w--full shrink-0 gap--medium mc-info">
  <div class="shrink-0 flex flex--col flex--left gap--xsmall">
    <span class="label label--small lg:label--base">BY</span>
    <span class="{{ info_cls }}" data-clamp="2">{{ provider }}</span>
  </div>

  {%- if agency != '' and agency != blank -%}
  <div class="shrink-0 flex flex--col flex--left gap--xsmall mc-info-fluid">
    <span class="label label--small lg:label--base">FOR</span>
    <span class="{{ info_cls }}" data-clamp="2">{{ agency }}</span>
  </div>
  {%- endif -%}

  <div class="shrink-0 flex flex--col flex--left gap--xsmall">
    <span class="label label--small lg:label--base">ON</span>
    <span class="{{ info_cls }} value--tnums" data-clamp="2">{{ date_ts | plus: trmnl.user.utc_offset | date: "%b %-d %H:%M" }}</span>
  </div>

  <div class="grow flex flex--col flex--left gap--xsmall mc-info-fluid">
    <span class="label label--small lg:label--base">FROM</span>
    <span class="{{ info_cls }}" data-clamp="2">{{ location_str }}</span>
  </div>
</div>

      <div class="divider shrink-0"></div>

      {%- comment -%} OG slots. Hidden on the X, which has its own pair below. {%- endcomment -%}
      <div class="grow flex flex--col w--full gap--small mc-clip lg:hidden">
        <div class="flex flex--col flex--left w--full gap--xsmall">
          <span class="label label--small lg:label--base">{{ slot_a_label }}</span>
          <span class="{{ a_cls }}" data-clamp="{{ a_clamp }}" data-clamp-portrait="3" data-clamp-lg-portrait="3">{{ slot_a_text }}</span>
        </div>

        {% if slot_b_text != "" %}
        <div class="divider shrink-0"></div>
        <div class="flex flex--col flex--left w--full gap--xsmall">
          <span class="label label--small lg:label--base">{{ slot_b_label }}</span>
          <span class="{{ b_cls }}" data-clamp="{{ b_clamp }}" data-clamp-portrait="4" data-clamp-lg-portrait="4">{{ slot_b_text }}</span>
        </div>
        {% endif %}
      </div>

      {%- comment -%} X slots. {%- endcomment -%}
      <div class="grow hidden lg:flex flex--col w--full gap--small mc-clip">
        <div class="flex flex--col flex--left w--full gap--xsmall">
          <span class="label label--small lg:label--base">{{ xa_label }}</span>
          <span class="{{ xa_cls }}" data-clamp="{{ xa_clamp }}" data-clamp-lg-portrait="3">{{ xa_text }}</span>
        </div>

        {% if xb_text != "" %}
        <div class="divider shrink-0"></div>
        <div class="flex flex--col flex--left w--full gap--xsmall">
          <span class="label label--small lg:label--base">{{ xb_label }}</span>
          <span class="{{ xb_cls }}" data-clamp="{{ xb_clamp }}" data-clamp-lg-portrait="4">{{ xb_text }}</span>
        </div>
        {% endif %}

        {% if xc_text != "" %}
        <div class="divider shrink-0"></div>
        <div class="flex flex--col flex--left w--full gap--xsmall">
          <span class="label label--small lg:label--base">{{ xc_label }}</span>
          <span class="{{ xc_cls }}" data-clamp="4" data-clamp-lg-portrait="2">{{ xc_text }}</span>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="divider--v stretch-y shrink-0 portrait:hidden"></div>
    <div class="divider shrink-0 hidden portrait:visible"></div>

    {%- comment -%} ============ SIDEBAR ============ {%- endcomment -%}
    {%- comment -%} lg:grow: flex--row centres its children, which left the
        two columns inset from the full-width footer on the X. Letting the
        sidebar take the slack lines both edges up with it. {%- endcomment -%}
    <div class="w--[31cqw] lg:grow portrait:w--full h--full portrait:h--[40cqh] {% if has_footer %}lg:portrait:h--[34cqh]{% endif %} flex flex--col gap--small">

      {%- comment -%} Destination name, then on the X what it means. The OG
          keeps the orbit name; the X shows destination, which is the
          station for an ISS-bound flight. Visibility sits on wrappers, not on
          the clamped spans, so the clamp cannot override it. {%- endcomment -%}
      <div class="flex flex--col flex--left w--full shrink-0 gap--xsmall">
        <span class="label label--small lg:label--base">DESTINATION</span>
        {%- if destination != blank and destination != orbit -%}
          <div class="lg:hidden"><span class="title--small" data-clamp="2">{{ orbit }}</span></div>
          <div class="hidden lg:block"><span class="title--small lg:title--base" data-clamp="2">{{ destination }}</span></div>
        {%- else -%}
          <span class="title--small lg:title--base" data-clamp="2">{{ orbit }}</span>
        {%- endif -%}
        {%- if destination_explanation != blank -%}
          <div class="hidden lg:block">
            <span class="description lg:description--large mc-regular" data-clamp="5" data-clamp-lg-portrait="2">{{ destination_explanation }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="divider shrink-0"></div>

      <div class="grow flex flex--row {% if rocket_ascending %}flex--top{% else %}flex--bottom{% endif %} flex--center-x w--full h--min-[40cqh] lg:h--min-[28cqh] portrait:h--min-[16cqh] mc-clip">
        <img
          class="image w--max-full h--max-full"
          src="{{ rocket_visual }}"
          data-alt="{{ rocket_visual_alt }}"
          data-gen="{{ generic_visual }}"
          onerror="if(this.dataset.f!='1'&&this.dataset.alt){this.dataset.f='1';this.src=this.dataset.alt;}else{this.onerror=null;this.src=this.dataset.gen;}"
        />
      </div>

      <div class="divider shrink-0"></div>
      <div class="flex flex--col flex--left w--full shrink-0 gap--xsmall">
        <span class="label label--small lg:label--base">ROCKET USED</span>
        <span class="title lg:title--large" data-clamp="2">{{ rocket }}</span>
      </div>
    </div>

  </div>

  {%- comment -%} ============ FOOTER (X only) ============
      What follows the launch on screen, after it has flown: its docking if
      one is scheduled, else the next launch with real timing. Every field
      comes from that one event. Rendered only when there is one. {%- endcomment -%}
  {%- if has_footer -%}
  <div class="hidden lg:flex flex--col w--full shrink-0 gap--small">
    <div class="mc-rule shrink-0"></div>
    <div class="flex flex--row flex--bottom w--full gap--medium">
      <div class="flex flex--col flex--left grow gap--xsmall mc-min0">
        <span class="label label--small lg:label--base">{{ footer_label }}</span>
        <span class="title lg:title--base" data-clamp="1">{{ footer_title }}</span>
        {%- comment -%} Last row, bottom left, one line: who and where for a
            launch, the port for a docking. {%- endcomment -%}
        {%- if footer_kind == "launch" -%}
        <div class="flex flex--row flex--left flex--center-y w--full gap--small mc-oneline">
          {%- if footer_provider != blank -%}
            <span class="label label--small lg:label--base shrink-0">BY:</span>
            <span class="description lg:description--large shrink-0">{{ footer_provider }}</span>
          {%- endif -%}
          {%- if footer_location != blank -%}
            <span class="label label--small lg:label--base shrink-0 mc-gap-left">FROM:</span>
            <span class="description lg:description--large mc-ellipsis">{{ footer_location }}</span>
          {%- endif -%}
        </div>
        {%- elsif footer_detail != blank -%}
          <span class="description lg:description--large" data-clamp="1">{{ footer_detail }}</span>
        {%- endif -%}
      </div>
      <div class="flex flex--col flex--right shrink-0 gap--xsmall">
        <span class="label label--small lg:label--base">COUNTDOWN</span>
        <span class="label label--outline lg:label--xlarge value--tnums">{{ footer_countdown }}</span>
      </div>
    </div>
  </div>
  {%- endif -%}
  </div>
</div>
