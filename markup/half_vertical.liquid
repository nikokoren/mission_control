{%- assign v_title = 'title lg:title--large' -%}
{%- if name.size > 22 -%}{%- assign v_title = 'title title--small lg:title--base' -%}{%- endif -%}
{%- assign v_resolved = false -%}
{%- if status == 'Success' or status == 'Failure' or status == 'Partial Failure' -%}{%- assign v_resolved = true -%}{%- endif -%}
{%- assign v_has_next = false -%}
{%- if v_resolved -%}
  {%- if footer_kind == 'launch' or footer_kind == 'docking' -%}{%- assign v_has_next = true -%}{%- endif -%}
{%- endif -%}
{%- assign v_has_art = true -%}
{%- if rocket_visual == blank or rocket_visual contains 'empty.png' -%}{%- assign v_has_art = false -%}{%- endif -%}
{%- assign v_a_label = og_full_slot_a_label | default: slot_a_label -%}
{%- assign v_a_text = og_full_slot_a_text | default: slot_a_text -%}
{%- assign v_b_label = og_full_slot_b_label | default: slot_b_label -%}
{%- assign v_b_text = og_full_slot_b_text | default: slot_b_text -%}
{%- assign v_a_lines = 4 -%}
{%- assign v_a_lg_lines = 8 -%}
{%- assign v_b_lg_lines = 5 -%}
{%- unless v_has_art -%}
  {%- assign v_a_lines = 6 -%}
  {%- assign v_a_lg_lines = 12 -%}
  {%- assign v_b_lg_lines = 8 -%}
{%- endunless -%}
<div class="layout">
  <div class="flex flex--col w--full h--full gap--small mc-halfv">
    <div class="flex flex--row flex--top w--full shrink-0 gap--small">
      <div class="flex flex--col flex--left grow gap--xsmall mc-halfv-min">
        <span class="label label--small lg:label--base">MISSION</span>
        <span class="{{ v_title }}" data-clamp="2" data-clamp-portrait="4" data-clamp-lg-portrait="3">{{ name }}</span>
      </div>
      <div class="flex flex--col flex--right shrink-0 gap--xsmall">
        <span class="label label--small lg:label--base">{% if mode == 'PRE_LAUNCH' %}COUNTDOWN{% else %}STATUS{% endif %}</span>
        <span class="label label--outline lg:label--xlarge value--tnums">
          {% if mode == 'PRE_LAUNCH' %}{{ countdown }}
          {% elsif status == 'Success' %}SUCCESS
          {% elsif status == 'Failure' %}FAILURE
          {% elsif status == 'Partial Failure' %}PARTIAL FAIL
          {% elsif status == 'PENDING' %}CONFIRMING
          {% else %}{{ status | upcase }}{% endif %}
        </span>
      </div>
    </div>
    <div class="flex flex--col flex--top flex--left w--full gap--medium mc-halfv-min mc-halfv-context {% if v_has_art %}shrink-0{% else %}grow{% endif %}">
      <div class="flex flex--col flex--top flex--left w--full shrink-0 gap--xsmall mc-halfv-card">
        <span class="label label--small lg:label--base" data-clamp="1">{{ v_a_label }}</span>
        <span class="description description--large mc-regular w--full" data-clamp="{{ v_a_lines }}" data-clamp-lg="{{ v_a_lg_lines }}" data-clamp-portrait="8" data-clamp-lg-portrait="10">{{ v_a_text }}</span>
      </div>
      {% if v_b_text != blank %}
      <div class="{% if v_has_art %}hidden portrait:flex lg:flex{% else %}flex{% endif %} flex--col flex--top flex--left w--full shrink-0 gap--xsmall mc-halfv-card">
        <span class="label label--small lg:label--base" data-clamp="1">{{ v_b_label }}</span>
        <span class="description description--large mc-regular w--full" data-clamp="4" data-clamp-lg="{{ v_b_lg_lines }}" data-clamp-portrait="8" data-clamp-lg-portrait="7">{{ v_b_text }}</span>
      </div>
      {% endif %}
    </div>
    {% if v_has_art %}
    <div class="grow w--full h--full mc-halfv-image">
      <img class="image image--contain w--full h--full" src="{{ rocket_visual }}" data-alt="{{ rocket_visual_alt }}" data-gen="{{ generic_visual }}"
           onerror="if(this.dataset.f!='1'&&this.dataset.alt){this.dataset.f='1';this.src=this.dataset.alt;}else{this.onerror=null;this.src=this.dataset.gen;}" />
    </div>
    {% endif %}
    <div class="flex flex--col flex--left w--full shrink-0 gap--xsmall">
      <span class="label label--small lg:label--base">ROCKET USED</span>
      <span class="title lg:title--large" data-clamp="2">{{ rocket }}</span>
    </div>
    {% if v_has_next %}
    <div class="flex flex--col w--full shrink-0 gap--small mc-halfv-next">
      <div class="mc-rule shrink-0"></div>
      <div class="flex flex--row flex--top w--full gap--small">
        <div class="grow flex flex--col flex--left gap--xsmall mc-halfv-min">
          <span class="label label--small lg:label--base">{{ footer_label }}</span>
          <span class="title title--small lg:title--base" data-clamp="2" data-clamp-portrait="3" data-clamp-lg-portrait="2">{{ footer_title }}</span>
        </div>
        <div class="flex flex--col flex--right shrink-0 gap--xsmall">
          <span class="label label--small lg:label--base">COUNTDOWN</span>
          <span class="label label--outline lg:label--large value--tnums">{{ footer_countdown }}</span>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
